# =============================================================
# 이 파일을 복사해서 .env 라는 이름으로 만든 뒤 키를 넣으십시오.
#
#   cp .env.example .env
#
# .env 는 .gitignore 에 걸려 있어 GitHub 에 올라가지 않습니다.
# =============================================================

# Google AI Studio 에서 받은 키 (AIza 로 시작합니다)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=여기에_키를_붙여넣으세요

# Supabase 접속 정보 (챗봇이 문서 표를 읽는 데 씁니다)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=여기에_anon_key
